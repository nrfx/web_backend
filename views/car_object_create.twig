{% extends "__layout.twig" %}

{% block content %}
    {% if object %}
        <h1>Редактирование автомобиля</h1>
    {% else %}
        <h1>Добавление автомобиля</h1>
    {% endif %}
    <hr>

    {% if message %}
        <div class="alert alert-info">
            {{ message }}
            <a href="/car-objects/{{id}}">Посмотреть</a>
        </div>
    {% endif %}

    <form action="" method="POST" class="row g-3" enctype="multipart/form-data">
        <div class="col-4">
            <label class="form-label">Название</label>
            <input type="text" class="form-control" name="title" value="{{ object.title ?? '' }}">
        </div>
        <div class="col-4">
            <label class="form-label">Краткое описание</label>
            <input type="text" class="form-control" name="description" value="{{ object.description ?? '' }}">
        </div>
        <div class="col-4">
            <label class="form-label">Марка</label>
            <select class="form-control" name="type">
                {% for type in types %}
                    <option value="{{ type.type }}" {% if type.type == object.type %}selected{% endif %}>
                        {{ type.type }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Фото</label>
            <input class="form-control" type="file" name="image">
            {% if object.image %}
                <small class="text-muted">Текущее фото: {{ object.image }} (оставьте пустым, чтобы не менять)</small>
            {% endif %}
        </div>
        <div class="col-12">
            <textarea name="info" placeholder="Полное описание..." class="form-control" rows="5">{{ object.info ?? '' }}</textarea>
        </div>
        <div class="col-12 text-end">
            {% if object %}
                <button type="submit" class="btn btn-success">Сохранить</button>
            {% else %}
                <button type="submit" class="btn btn-primary">Добавить</button>
            {% endif %}
        </div>
    </form>

{% endblock %}