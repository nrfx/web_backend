{% extends "__layout.twig" %}

{% block content %}
    <h1>Honda</h1>
    <ul class="nav nav-pills">
        <li class="nav-item">
            <a class="nav-link {{ page == 'image' ? 'active' : '' }}" href="/honda/image">
                Картинка
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ page == 'info' ? 'active' : '' }}" href="/honda/info">Информация</a>
        </li>
    </ul>
    <br>
    
    {% if page == 'image' %}
        <img src="/images/honda.jpg" alt="Honda" style="width: 50%; height: auto;">
    {% elseif page == 'info' %}
        <p>Honda Stepwgn 2015 года, черная. Двигатель 1.5сс L15B 4-цилиндровый. <br>Куплена в 2022 году с рук но без пробега по России. Изначальная оценка японского аукциона 3,5.</p>
    {% endif %}
{% endblock %}
