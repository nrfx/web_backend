{% extends "__layout.twig" %}

{% block content %}
    <h1>Toyota</h1>
    <ul class="nav nav-pills">
        <li class="nav-item">
            <a class="nav-link {{ page == 'image' ? 'active' : '' }}" href="/toyota/image">
                Картинка
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ page == 'info' ? 'active' : '' }}" href="/toyota/info">Информация</a>
        </li>
    </ul>
    <br>
    
    {% if page == 'image' %}
        <img src="/images/car.jpg" alt="Toyota" style="width: 50%; height: auto;">
    {% elseif page == 'info' %}
        <p>Toyota wish 2014 года, серая. Двигатель 1.8cc 2ZR-FAE 4-цилиндровый. Куплена в 2025 году с японского аукциона USS Nagoya и доставлена в порт Fushiki для дальнешйей перевозки во Владивосток. 
        <br>Оттуда машина была доставлена автовозом в Иркутск.</p>
    {% endif %}
{% endblock %}
