{% extends "__layout.twig" %}
{% import "macros.twig" as ui %}

{% block content %}
    <h1>{{title}}</h1>
    сообщение из сессии {{my_session_message}}
    <br>
    последние сообщения:<br>
    {% for m in messages %}
        {{m}}<br>
    {% endfor %}
    <hr>

    <ul class="nav nav-pills">
        {% for item in objectMenu %}
            <li class="nav-item">
                {{ ui.btn(item.title, item.url, item.active) }}
            </li>
        {% endfor %}
    </ul>
    <br>

    {% block objectContent %}
        {% if description is defined %}
            <p>{{ description }}</p>
        {% else %}
            <p>Выберите вверху какую информацию хотите посмотреть =О</p>
        {% endif %}
    {% endblock %}
{% endblock %}