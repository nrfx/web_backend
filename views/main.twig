{% extends "__layout.twig" %}

{% block content %}
    <h1>Главная страница</h1>

    <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;">
        {% for object in car_objects %}
            <div class="card position-relative" style="width: 200px; text-align: center;">
                <div class="position-absolute d-flex" style="right: 4px; top: 4px; gap: 4px;">
                    <form href="/car-objects/{{object.id}}/update" class="btn btn-warning btn-sm">
                        <i class="fas fa-pen"></i>
                    </form>
                    <form action="/car-objects/{{object.id}}/delete" method="POST">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-times"></i>
                        </button>
                    </form>
                </div>
                <img src="{{ object.image }}" class="card-img-top" alt="{{ object.title }}" style="height: 150px; object-fit: cover;">
                <div class="card-body">
                    <a href="/car-objects/{{object.id}}" class="btn btn-primary w-100 mb-2">{{ object.title }}</a>
                    <div>
                        <a href="/car-objects/{{object.id}}?show=image">Картинка</a>
                        <a href="/car-objects/{{object.id}}?show=info">Описание</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}