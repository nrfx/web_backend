{% extends "__layout.twig" %}

{% block content %}
    <h1>Поиск</h1>

    <form action="">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="type" class="form-label">Тип</label>
                <select id="type" name="type" class="form-select">
                    <option value="">Все</option>
                    {% for type in types %}
                        <option value="{{ type.type }}">{{ type.type|title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="title" class="form-label">Название</label>
                <input type="text" id="title" name="title" class="form-control">
            </div>
            <div class="col-md-3">
                <label for="info" class="form-label">Описание</label>
                <input type="text" id="info" name="info" class="form-control">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">Найти</button>
            </div>
        </div>
    </form>


    {% if objects is not empty %}
        <ul>
            {% for obj in objects %}
                <li><a href="/car-objects/{{ obj.id }}">{{ obj.title }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}